component NativeInput
  state count = 0
  state draft = ""
  state scrolled = false
  action click
    count = count + 1
  action type(value: string)
    draft = value
  action bottom
    scrolled = true
  view
    column gap=0 width="100%" height="100%" background-color="#FFFFFF"
      row height=80
        button press=click testId="click" width=200 height=80
          text "Click me"
        box width=100 height=80 background-color=(count % 2 == 1 ? "#00FF00" : "#FF0000")
      row height=60
        input value=draft input=type testId="entry" width=200 height=60
        box width=100 height=60 background-color=(draft == "hello" ? "#0000FF" : "#FF0000")
      box width=300 height=180 overflow-y="scroll"
        column gap=0
          box height=480
          button press=bottom testId="bottom" width=200 height=60
            text "Bottom"
      box width=300 height=60 background-color=(scrolled ? "#FFFF00" : "#FF0000")
